
{
  "entities": {
    "ProjectInquiry": {
      "title": "Project Inquiry",
      "description": "A request for a new project submission from a potential client.",
      "type": "object",
      "properties": {
        "projectType": { "type": "string", "enum": ["web", "mobile", "ai", "cloud"] },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "description": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "company": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "reviewing", "contacted", "closed"], "default": "new" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectType", "fullName", "email", "phoneNumber", "description"]
    },
    "Project": {
      "title": "Active Project",
      "description": "A live project being executed for a client.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "clientName": { "type": "string" },
        "clientId": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "active", "on-hold", "completed"] },
        "progress": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "clientName", "status"]
    },
    "NewsArticle": {
      "title": "News Article",
      "description": "A blog post or news insight.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "excerpt", "image"]
    },
    "ServiceNode": {
      "title": "Service Node",
      "description": "A service offered by HITECH.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "tag": { "type": "string" },
        "href": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description"]
    },
    "TeamMember": {
      "title": "Team Member",
      "description": "An engineering or design unit.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" },
        "initials": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "bio"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client feedback and verification.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "stars": { "type": "number" },
        "project": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "text", "stars"]
    },
    "BannerNode": {
      "title": "Banner Node",
      "description": "Sliding showcase items for the footer and headers.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "imageHint": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["image"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended information for authenticated users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "staff", "client"], "default": "client" },
        "salary": { "type": "number" },
        "accessiblePortals": { "type": "array", "items": { "type": "string" } },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Internal tasks assigned to HITECH staff members.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "assignedTo"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily punch-in logs for staff members.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string" },
        "punchInTime": { "type": "string", "format": "date-time" },
        "punchOutTime": { "type": "string", "format": "date-time" },
        "officeCodeUsed": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "date"]
    },
    "Requisition": {
      "title": "Requisition",
      "description": "A formal request for funds or materials.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string" },
        "department": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "userId", "totalAmount"]
    },
    "OfficeCode": {
      "title": "Office Code",
      "description": "Daily validation code required for attendance punch-in.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "date": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "date"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/projectInquiries/{inquiryId}": {
      "schema": "#/backend/entities/ProjectInquiry",
      "description": "Collection of project requests."
    },
    "/projects/{projectId}": {
      "schema": "#/backend/entities/Project",
      "description": "Collection of active projects."
    },
    "/news/{articleId}": {
      "schema": "#/backend/entities/NewsArticle",
      "description": "CMS News Articles."
    },
    "/services/{serviceId}": {
      "schema": "#/backend/entities/ServiceNode",
      "description": "Managed Services."
    },
    "/team/{memberId}": {
      "schema": "#/backend/entities/TeamMember",
      "description": "Engineering Units."
    },
    "/testimonials/{testId}": {
      "schema": "#/backend/entities/Testimonial",
      "description": "Client Testimonials."
    },
    "/banners/{bannerId}": {
      "schema": "#/backend/entities/BannerNode",
      "description": "Site Banners."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    },
    "/tasks/{taskId}": {
      "schema": "#/backend/entities/Task",
      "description": "Workforce tasks."
    },
    "/attendance/{logId}": {
      "schema": "#/backend/entities/Attendance",
      "description": "Attendance logs."
    },
    "/requisitions/{reqId}": {
      "schema": "#/backend/entities/Requisition",
      "description": "Fund requests."
    },
    "/officeCodes/{codeId}": {
      "schema": "#/backend/entities/OfficeCode",
      "description": "Daily codes."
    }
  }
}


{
  "entities": {
    "ProjectInquiry": {
      "title": "Project Inquiry",
      "description": "A request for a new project submission from a potential client.",
      "type": "object",
      "properties": {
        "projectType": { "type": "string", "enum": ["web", "mobile", "ai", "cloud"] },
        "budget": { "type": "string" },
        "timeline": { "type": "string" },
        "description": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "company": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "reviewing", "contacted", "closed"], "default": "new" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectType", "fullName", "email", "phoneNumber", "description"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "A formal price estimate for a client project.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "projectTitle": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string", "default": "USD" },
        "status": { "type": "string", "enum": ["draft", "sent", "accepted", "rejected"], "default": "draft" },
        "expiryDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "projectTitle", "totalAmount"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A formal billing document for services rendered.",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["unpaid", "partially-paid", "paid", "overdue"] },
        "dueDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["invoiceNumber", "clientName", "amount", "status"]
    },
    "LPO": {
      "title": "Local Purchase Order",
      "description": "A document issued by a buyer to a seller indicating types, quantities, and agreed prices.",
      "type": "object",
      "properties": {
        "lpoNumber": { "type": "string" },
        "supplier": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "fulfilled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["lpoNumber", "supplier", "amount"]
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "A submission from a candidate applying for a position at HITECH.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string" },
        "portfolio": { "type": "string" },
        "coverLetter": { "type": "string" },
        "resumeUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["applied", "interviewing", "hired", "rejected"], "default": "applied" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "phoneNumber", "role"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "General messages from the contact form.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "budget": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "archived"], "default": "unread" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "phoneNumber", "message"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended information for authenticated users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "staff", "client"], "default": "client" },
        "company": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Internal tasks assigned to HITECH staff members.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedTo": { "type": "string" },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["todo", "in-progress", "completed", "verified"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "assignedTo", "priority", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily punch-in logs for staff members.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "date": { "type": "string" },
        "punchInTime": { "type": "string", "format": "date-time" },
        "officeCodeUsed": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
      },
      "required": ["userId", "date", "status"]
    },
    "OfficeCode": {
      "title": "Office Code",
      "description": "Daily validation code required for attendance punch-in.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "date": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "date"]
    },
    "SitePage": {
      "title": "Site Page",
      "description": "A website page configuration and content for the CMS.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "author": { "type": "string" },
        "lastModified": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "path", "status"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/projectInquiries/{inquiryId}": {
      "schema": "#/backend/entities/ProjectInquiry",
      "description": "Collection of project requests."
    },
    "/quotations/{quotationId}": {
      "schema": "#/backend/entities/Quotation",
      "description": "Formal project estimates."
    },
    "/invoices/{invoiceId}": {
      "schema": "#/backend/entities/Invoice",
      "description": "Billing documents."
    },
    "/lpos/{lpoId}": {
      "schema": "#/backend/entities/LPO",
      "description": "Local Purchase Orders."
    },
    "/jobApplications/{applicationId}": {
      "schema": "#/backend/entities/JobApplication",
      "description": "Collection of candidate applications."
    },
    "/contactMessages/{messageId}": {
      "schema": "#/backend/entities/ContactMessage",
      "description": "General system messages."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    },
    "/tasks/{taskId}": {
      "schema": "#/backend/entities/Task",
      "description": "Workforce task assignments."
    },
    "/attendance/{logId}": {
      "schema": "#/backend/entities/Attendance",
      "description": "Staff attendance logs."
    },
    "/officeCodes/{codeId}": {
      "schema": "#/backend/entities/OfficeCode",
      "description": "Daily office validation codes."
    },
    "/sitePages/{pageId}": {
      "schema": "#/backend/entities/SitePage",
      "description": "CMS page configurations."
    }
  }
}
